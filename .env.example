# Restaurant agent settings, read from environment variables (export them, or set them in your shell profile).

# Any OpenAI-compatible server; developed with LM Studio on port 1235.
LLM_BASE_URL=http://localhost:1235/v1
LLM_MODEL=gemma-4-26b-a4b-it
LLM_CONTEXT_LENGTH=16384

# The SQLite database with the demo restaurants (default: restaurant_agent.db in the project folder).
# RESTAURANT_DB_PATH=

# Speech-to-text model for faster-whisper.
WHISPER_MODEL=large-v3-turbo

# Booking gate (docs/DECISIONS.md): a calibrated check that the guest said yes before book_table runs. 0 = off.
DECISION_GATE=1
CALIBRATION_DIR=evals/decisions/calibration
DECISION_TIMEOUT_SECONDS=30
